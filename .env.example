# Copy to `.env` (never committed). Read in development; keys pasted in Settings > Providers win over these.
# Every provider is optional: the app offers only the models whose provider has a key.

# ---- LLM providers ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
# Groq key pool instead of GROQ_API_KEY: a comma/newline list, or a JSON array of {key, label?}. Rotated on 429.
GROQ_KEYS=
GOOGLE_GENERATIVE_AI_API_KEY=
XAI_API_KEY=
# Optional: scope Anthropic requests to one workspace (sent as a header)
ANTHROPIC_WORKSPACE_ID=

# ---- Voice-clone dataset capture (docs/TRAINING_RECORDING.md). Off unless =1 ----
RECORD_TRAINING_DATA=
# Where takes go. Default: <app data>/training/raw
RECORD_DIR=
RECORD_ROOMTONE=
RECORD_SYSTEM_PROMPT_FILE=

# ---- Python for the ear sidecar. Default: the setting, then sidecar/.venv, then `python` on PATH ----
VA_PYTHON=

# ---- Lab scripts (pnpm lab:*), real Claude Agent SDK runs ----
# LAB_WORKSPACE=   folder the lab sessions may touch (default: <temp>/voice-agent-lab)
# LAB_MODEL=       model for the lab sessions

# ---- Shell-only dev hooks (set in the shell before `pnpm dev`; not read from this file) ----
# VA_USER_DATA=<dir>     run against a separate app-data folder (fresh-user testing)
# VA_SAY="hello"         send a typed message after launch
# VA_WAV=file.wav        replay a 16 kHz mono wav through the ears; VA_WAV2 injects a second one while the agent speaks
# VA_MIC=1               press the Voice button for you
# VA_VIEW=claude         open a rail view (chat|claude|memory|prompts|skills|projects|diagnostics|settings); VA_VIEW_DELAY ms
# VA_SCREENSHOT=out.png  capture the window after VA_SCREENSHOT_DELAY ms
# VA_TRACE=1             print the session trace path on quit
# EAR_INTEGRATION=1 EAR_WAV=a.wav EAR_BARGE_WAV=b.wav   opt-in sidecar integration test with real models
# HF_HOME=<dir>          Hugging Face cache for Parakeet and Kokoro downloads
